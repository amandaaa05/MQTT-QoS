[
    {
        "id": "flow_1",
        "type": "tab",
        "label": "Dashboard Estufa",
        "disabled": false,
        "info": "Dashboard MQTT QoS"
    },
    {
        "id": "mqtt_broker_1",
        "type": "mqtt-broker",
        "name": "Mosquitto",
        "broker": "mosquitto",
        "port": "1883",
        "clientid": "node_red_dashboard",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "ui_base",
        "type": "ui-base",
        "name": "Base",
        "path": "/dashboard",
        "includeClientData": true,
        "acceptsClientConfig": [
            "ui-notification",
            "ui-control"
        ]
    },
    {
        "id": "ui_theme",
        "type": "ui-theme",
        "name": "Theme",
        "colors": {
            "surface": "#ffffff",
            "primary": "#1f77b4",
            "bgPage": "#f4f4f4",
            "groupBg": "#ffffff",
            "groupOutline": "#e0e0e0"
        },
        "sizes": {
            "pagePadding": "16px",
            "groupGap": "16px",
            "groupBorderRadius": "8px",
            "widgetGap": "12px"
        }
    },
    {
        "id": "ui_page",
        "type": "ui-page",
        "name": "Estufa Inteligente",
        "ui": "ui_base",
        "path": "/estufa",
        "icon": "home",
        "layout": "grid",
        "theme": "ui_theme",
        "order": 1,
        "className": ""
    },
    {
        "id": "group_sensores",
        "type": "ui-group",
        "name": "Sensores Ativos",
        "page": "ui_page",
        "width": "6",
        "height": "1",
        "order": 1,
        "showTitle": true,
        "className": "",
        "visible": "true",
        "disabled": "false"
    },
    {
        "id": "group_controle",
        "type": "ui-group",
        "name": "Painel de Controle",
        "page": "ui_page",
        "width": "6",
        "height": "1",
        "order": 2,
        "showTitle": true,
        "className": "",
        "visible": "true",
        "disabled": "false"
    },
    {
        "id": "mqtt_in_temp",
        "type": "mqtt in",
        "z": "flow_1",
        "name": "Temperatura",
        "topic": "estufa/temp/ambiente",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_1",
        "x": 110,
        "y": 80,
        "wires": [["func_temp"]]
    },
    {
        "id": "func_temp",
        "type": "function",
        "z": "flow_1",
        "name": "Extrair Temp",
        "func": "msg.payload = msg.payload.valor;\nreturn msg;",
        "outputs": 1,
        "x": 290,
        "y": 80,
        "wires": [["gauge_temp"]]
    },
    {
        "id": "gauge_temp",
        "type": "ui-gauge",
        "z": "flow_1",
        "name": "Termômetro",
        "group": "group_sensores",
        "order": 1,
        "width": 6,
        "height": 5,
        "gtype": "gauge-half",
        "gstyle": "rounded",
        "title": "Temperatura",
        "units": "°C",
        "icon": "thermometer",
        "min": 0,
        "max": 50,
        "segments": [
            {"from": 0, "color": "#5CD65C", "text": "Normal", "textType": "label"},
            {"from": 25, "color": "#FFC800", "text": "Alerta", "textType": "label"},
            {"from": 35, "color": "#EA5353", "text": "Perigo", "textType": "label"}
        ],
        "sizeThickness": 16,
        "sizeGap": 4,
        "sizeKeyThickness": 8,
        "className": "",
        "x": 470,
        "y": 80,
        "wires": []
    },
    {
        "id": "mqtt_in_agua",
        "type": "mqtt in",
        "z": "flow_1",
        "name": "Nível Água",
        "topic": "estufa/agua/nivel",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_1",
        "x": 100,
        "y": 140,
        "wires": [["func_agua"]]
    },
    {
        "id": "func_agua",
        "type": "function",
        "z": "flow_1",
        "name": "Extrair Nível",
        "func": "msg.payload = msg.payload.valor;\nreturn msg;",
        "outputs": 1,
        "x": 290,
        "y": 140,
        "wires": [["gauge_agua"]]
    },
    {
        "id": "gauge_agua",
        "type": "ui-gauge",
        "z": "flow_1",
        "name": "Reservatório",
        "group": "group_sensores",
        "order": 2,
        "width": 6,
        "height": 8,
        "gtype": "gauge-tank",
        "gstyle": "rounded",
        "title": "Nível de Água",
        "units": "%",
        "icon": "water",
        "min": 0,
        "max": 100,
        "segments": [
            {"from": 0, "color": "#EA5353", "text": "Crítico", "textType": "label"},
            {"from": 20, "color": "#FFC800", "text": "Baixo", "textType": "label"},
            {"from": 50, "color": "#53B4FD", "text": "Normal", "textType": "label"}
        ],
        "sizeThickness": 16,
        "sizeGap": 4,
        "sizeKeyThickness": 8,
        "className": "",
        "x": 470,
        "y": 140,
        "wires": []
    },
    {
        "id": "mqtt_in_incendio",
        "type": "mqtt in",
        "z": "flow_1",
        "name": "Incêndio",
        "topic": "estufa/alerta/incendio",
        "qos": "2",
        "datatype": "json",
        "broker": "mqtt_broker_1",
        "x": 100,
        "y": 200,
        "wires": [["debug_incendio"]]
    },
    {
        "id": "debug_incendio",
        "type": "debug",
        "z": "flow_1",
        "name": "ALERTA",
        "active": true,
        "console": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 280,
        "y": 200,
        "wires": []
    },
    {
        "id": "ui_switch_bomba",
        "type": "ui-switch",
        "z": "flow_1",
        "name": "Bomba D'água",
        "label": "Bomba de Irrigação",
        "group": "group_controle",
        "order": 1,
        "width": 0,
        "height": 0,
        "passthru": false,
        "decouple": "false",
        "topic": "estufa/controle/bomba",
        "topicType": "msg",
        "style": "",
        "layout": "row-spread",
        "clickableArea": "switch",
        "onvalue": "true",
        "onvalueType": "bool",
        "onicon": "",
        "oncolor": "",
        "offvalue": "false",
        "offvalueType": "bool",
        "officon": "",
        "offcolor": "",
        "x": 120,
        "y": 300,
        "wires": [["func_controle"]]
    },
    {
        "id": "func_controle",
        "type": "function",
        "z": "flow_1",
        "name": "Formata JSON",
        "func": "msg.payload = {\n    ligada: msg.payload,\n    timestamp: new Date().toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "x": 300,
        "y": 300,
        "wires": [["mqtt_out_bomba", "debug_comando"]]
    },
    {
        "id": "mqtt_out_bomba",
        "type": "mqtt out",
        "z": "flow_1",
        "name": "Publicar Comando",
        "topic": "estufa/controle/bomba",
        "qos": "1",
        "retain": "false",
        "broker": "mqtt_broker_1",
        "x": 510,
        "y": 300,
        "wires": []
    },
    {
        "id": "debug_comando",
        "type": "debug",
        "z": "flow_1",
        "name": "Debug Comando",
        "active": true,
        "console": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 510,
        "y": 340,
        "wires": []
    }
]
